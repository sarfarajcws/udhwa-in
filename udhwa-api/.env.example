# ── udhwa-api ────────────────────────────────────────────────────────────────
# Copy to .env for local development. On Render, set these in the service's
# Environment tab (never commit real values). In production (NODE_ENV=production)
# the API refuses to start unless every REQUIRED value below is set and valid.

NODE_ENV=development
PORT=4000

# ── Database (Neon PostgreSQL) — REQUIRED ─────────────────────────────────────
# Pooled connection string for the app (Neon dashboard → Connection string →
# "Pooled connection"), e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/udhwa?sslmode=require
DATABASE_URL="postgresql://udhwa:udhwa@localhost:5432/udhwa?schema=public"
# Direct (non-pooled) connection string — used only for migrations.
DIRECT_URL="postgresql://udhwa:udhwa@localhost:5432/udhwa?schema=public"
# Connections per API instance (Neon's pooler multiplexes these). Default 10.
# DATABASE_POOL_MAX=10

# ── Front-end URLs — REQUIRED (https:// in production) ───────────────────────
# Used for OAuth redirect URIs, CORS and cache revalidation.
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
# Extra front-end origins, comma separated (e.g. a Vercel preview URL you want to sign in on).
ALLOWED_ORIGINS=""
# Where the API reaches the website for cache revalidation, if not WEB_URL.
# WEB_INTERNAL_URL=""

# ── Sessions & secrets — REQUIRED ────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# Signs OAuth state cookies and salts hashed IPs (min 32 chars in production).
SESSION_SECRET="change-me-to-a-long-random-string"
# Shared with udhwa-next (same value there); protects POST /api/revalidate (min 24 chars in production).
REVALIDATE_SECRET="change-me-to-another-long-random-string"

# ── Google OAuth — REQUIRED (the only sign-in method) ────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URIs (one per front-end, exactly):
#   <WEB_URL>/api/v1/auth/google/callback
#   <ADMIN_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: extra client IDs (Android/iOS apps) whose ID tokens POST /v1/auth/google/token accepts.
GOOGLE_MOBILE_CLIENT_IDS=""

# ── Admin access — REQUIRED ──────────────────────────────────────────────────
# Google account emails that are admins, comma separated. This list is the only
# source of admin access: removing an email revokes it on the next request.
ADMIN_EMAILS=""

# ── Cloudinary (media) — REQUIRED in production ──────────────────────────────
# Cloudinary console → Settings → API Keys. Uploads are signed by the API; no
# upload preset or unsigned uploads are needed (keep unsigned uploads disabled).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Root folder for uploads (library/ and contributions/<user>/ go inside it).
CLOUDINARY_FOLDER="udhwa"

# ── Optional ─────────────────────────────────────────────────────────────────
# Log every request in production (by default only errors and slow requests are logged).
# LOG_REQUESTS=true

# ── Automated tests only (ignored when NODE_ENV=production) ──────────────────
# Point Google and Cloudinary at the local stand-ins in scripts/mock-providers.mjs.
# GOOGLE_TEST_BASE_URL="http://localhost:4100/google"
# CLOUDINARY_API_BASE_URL="http://localhost:4100/cloudinary"
