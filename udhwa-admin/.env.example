# ── udhwa-admin (admin / CMS) ───────────────────────────────────────────────
# Copy to .env.local for local development. On Vercel: Project → Settings →
# Environment Variables. Only NEXT_PUBLIC_* values reach the browser.

# Base URL of udhwa-api (local: http://localhost:4000, production: your Render URL). Server-side only.
API_URL="http://localhost:4000"

# Public URLs: the website (for "View live" links) and this admin app.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Admin access is not configured here: it is controlled by ADMIN_EMAILS on udhwa-api.
