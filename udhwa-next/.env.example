# ── udhwa-next (public website) ─────────────────────────────────────────────
# Copy to .env.local for local development. On Vercel: Project → Settings →
# Environment Variables. Only NEXT_PUBLIC_* values reach the browser; the
# others stay on the server.

# Base URL of udhwa-api (local: http://localhost:4000, production: your Render URL,
# e.g. https://udhwa-api.onrender.com). Server-side only.
API_URL="http://localhost:4000"

# Public URLs (used for canonical URLs, sitemap, Open Graph and the /admin redirect).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
# Public contact address shown on the contact page and in structured data.
NEXT_PUBLIC_CONTACT_EMAIL="contact@udhwa.in"

# Same value as REVALIDATE_SECRET on udhwa-api. Server-side only.
REVALIDATE_SECRET="change-me-to-another-long-random-string"
